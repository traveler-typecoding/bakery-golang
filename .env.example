# Copy to .env and adjust: copy .env.example .env
# goose reads .env automatically when run from this folder.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT in bakery-infra/.env.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://bakery:changeme@localhost:5432/bakerydb?sslmode=disable
GOOSE_MIGRATION_DIR=migrations
